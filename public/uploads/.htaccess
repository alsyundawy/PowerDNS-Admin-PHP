# Prevent direct execution of script files in uploads
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|cgi|pl|sh|bash)$">
    Require all denied
</FilesMatch>
Options -ExecCGI -Indexes
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
