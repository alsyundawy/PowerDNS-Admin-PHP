<?xml version="1.0"?>
<ruleset name="PowerDNS-Admin-PHP">
    <description>PSR-12 coding standard for PowerDNS-Admin-PHP</description>
    <rule ref="PSR12">
        <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace"/>
    </rule>
    <rule ref="Generic.WhiteSpace.ScopeIndent">
        <exclude-pattern>views/*</exclude-pattern>
    </rule>
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>views/*</exclude-pattern>
    </rule>
    <file>app</file>
    <file>public</file>
    <file>views</file>
    <file>tests</file>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>public/assets/vendor/*</exclude-pattern>
    <exclude-pattern>.kilo/*</exclude-pattern>
</ruleset>
