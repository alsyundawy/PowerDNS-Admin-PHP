{
  "name": "alsyundawy/powerdns-admin-php",
  "description": "Enterprise Authoritative PowerDNS Web Control Plane in Native PHP & PDO. Zero-Framework, Air-Gapped Zero-CDN, 2FA TOTP, Multi-Server Clustering, In-Memory Caching & RFC-Compliant Engine.",
  "keywords": [
    "powerdns",
    "dns",
    "dnssec",
    "control-plane",
    "authoritative-dns",
    "clustering",
    "totp-2fa",
    "webhooks",
    "zero-cdn"
  ],
  "version": "0.3.0",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "files": [
      "app/bootstrap.php",
      "app/csrf.php",
      "app/dns_name.php",
      "app/network_tools.php",
      "app/PdnsDnssecTrait.php",
      "app/PdnsMetadataTrait.php",
      "app/PdnsClient.php",
      "app/totp.php",
      "app/PdnsCluster.php",
      "app/cache.php",
      "app/webhook_services.php",
      "app/zone_linter.php",
      "app/analytics.php",
      "app/services.php",
      "app/backup_services.php",
      "app/handlers.php"
    ]
  },
  "require-dev": {
    "phpstan/phpstan": "^2.2",
    "friendsofphp/php-cs-fixer": "^3.95",
    "vimeo/psalm": "^6.19"
  }
}
